struct Ability {
    string dataId;
    int hotkey;
    int line;
    int tier;
    int level;

    AbilityLearn[ABILITY_LEARN_ARRAY_MAX] abilityLearn;
    AbilityStats[ABILITY_STATS_ARRAY_MAX] abilityStats;
};

void abilityInitialize(int player);

void AbilityLevelup(int player, int hotkey);

void AbilityStatsUp(int player, int statIndex, fixed value);

void abilityUpgradeExcuteFunc(int player, int hotkey, int upgradeType, string dataId, fixed value);

void testCode();



